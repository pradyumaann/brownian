{
  "name": "brownian",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "prebuild": "node scripts/fetch-brief.mjs",
    "build": "next build && node scripts/fix-export-segments.mjs",
    "check": "npm run lint:copy && node scripts/check.mjs",
    "lint:copy": "node scripts/lint-copy.mjs",
    "test:portfolio": "node --test lib/portfolioMath.test.ts lib/resultDates.test.ts",
    "test:backend": "node scripts/make-spec.mjs --check && node --test supabase/functions/_shared/validate.test.ts supabase/functions/_shared/intake.test.ts supabase/functions/_shared/merge.test.ts",
    "check:plots": "node scripts/audit-plots.mjs",
    "history": "node scripts/history/update.mjs",
    "history:verify": "node scripts/history/verify.mjs",
    "start": "npx serve out",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "next": "16.4.6",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@types/node": "^22",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "playwright-core": "^1.65.1",
    "typescript": "5.9.3"
  }
}
